<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>Vortex</Authors>
        <Version>0.4.1</Version>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>kite</AssemblyName>
        <RootNamespace>Kite</RootNamespace>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- To support Native AOT -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.57.2"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\presets.json"/>
        <EmbeddedResource Include="Resources\presets.json" LogicalName="kite.presets.json"/>
        <None Remove=".gitignore"/>
        <EmbeddedResource Remove="reference\**"/>
        <None Remove="reference\**"/>
    </ItemGroup>

    <!-- Prompt documents referenced from presets.json as "$name" -->
    <ItemGroup>
        <None Remove="Resources\Prompts/**"/>
        <EmbeddedResource Include="Resources\Prompts\**" LogicalName="kite.Prompts.%(Filename)%(Extension)"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="reference\**"/>
    </ItemGroup>

</Project>